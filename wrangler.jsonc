{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dot-panel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/mcp"]},
  "d1_databases": [{"binding":"DB","database_name":"dot-panel","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"drizzle"}]
}
