{
  "name": "dot-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:runtime": "node tests/runtime-crypto.mjs && node tests/runtime-auth.mjs && node tests/runtime-isolation.mjs && node tests/runtime-sites.mjs",
    "db:generate": "drizzle-kit generate",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:template": "node scripts/test-template.mjs",
    "test:recovery": "node tests/recovery.mjs",
    "build:sites": "node scripts/build-sites.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "drizzle-orm": "0.45.2",
    "radix-ui": "1.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "miniflare": "4.20260515.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
